      "Brian": "Brian (UK English - Classic Streamer)",
      "Raveena": "Raveena (Indian English - Female)",
      "Aditi": "Aditi (Indian English / Hindi - Female)",
      "Amy": "Amy (British English - Female)",
      "Emma": "Emma (British English - Female)",
      "Matthew": "Matthew (US English - Male)",
      "Joanna": "Joanna (US English - Female)",
      "Salli": "Salli (US English - Female)",
      "Russell": "Russell (Australian - Male)"
