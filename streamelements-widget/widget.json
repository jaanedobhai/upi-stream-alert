{
  "connectionMode": {
    "type": "dropdown",
    "label": "Connection Mode",
    "value": "firebase",
    "options": {
      "firebase": "🔥 Serverless (Firebase Realtime DB) [Recommended]",
      "websocket": "Cloud Server URL (Render / Railway)"
    }
  },
  "firebaseDbUrl": {
    "type": "text",
    "label": "Firebase Realtime Database URL",
    "value": "https://YOUR-PROJECT-ID-default-rtdb.firebaseio.com"
  },
  "alertDuration": {
    "type": "number",
    "label": "Alert Duration (Seconds)",
    "value": 6,
    "min": 2,
    "max": 30,
    "step": 1
  },
  "minAmount": {
    "type": "number",
    "label": "Minimum Amount (INR ₹)",
    "value": 1,
    "min": 1,
    "max": 10000,
    "step": 1
  },
  "enableTts": {
    "type": "checkbox",
    "label": "Enable Text-to-Speech (TTS)",
    "value": true
  },
  "soundUrl": {
    "type": "sound-input",
    "label": "Alert Sound URL",
    "value": "https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3"
  },
  "relayUrl": {
    "type": "text",
    "label": "WebSocket Server URL (Only if using WebSocket)",
    "value": "http://localhost:3000"
  }
}
